# Load these into your shell or hosting environment; Spring does not auto-load .env.
SERVER_ADDRESS=127.0.0.1
PORT=8080
# Add real OAuth client credentials only when implementing provider adapters.
# Keep LLM keys on the Android device; never put them in this backend.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=https://<tunnel-host>/api/oauth/facebook/callback
FACEBOOK_TARGET_PAGE_ID=
FACEBOOK_GRAPH_API_VERSION=v27.0

# Disable Facebook when running a LinkedIn-only spike.
FACEBOOK_OAUTH_ENABLED=true
LINKEDIN_OAUTH_ENABLED=false
LINKEDIN_CLIENT_ID=replace-with-client-id
LINKEDIN_CLIENT_SECRET=replace-with-secret-in-local-shell-only
LINKEDIN_OAUTH_REDIRECT_URI=https://your-host.example/api/oauth/linkedin/callback
# LINKEDIN_API_VERSION is consumed by the Android Gradle build, not this backend.
