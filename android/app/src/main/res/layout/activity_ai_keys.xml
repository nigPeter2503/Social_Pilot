<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="vertical" android:padding="24dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/ai_keys_title" android:textSize="24sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="@string/ai_keys_intro" android:textSize="15sp" />
    <include android:id="@+id/openAiKey" layout="@layout/item_ai_key" />
    <include android:id="@+id/geminiKey" layout="@layout/item_ai_key" />
  </LinearLayout>
</ScrollView>
