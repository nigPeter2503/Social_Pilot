<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="16dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="vertical" android:padding="16dp">
    <TextView android:id="@+id/channel_name"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceHeadline6" />
    <TextView android:id="@+id/channel_account"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textAppearance="?attr/textAppearanceBody1" />
    <TextView android:id="@+id/channel_account_id"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceBody2" />
    <TextView android:id="@+id/channel_status"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:textStyle="bold" />
    <TextView android:id="@+id/channel_cached_notice"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:text="@string/channels_cached_notice"
        android:visibility="gone" />
    <TextView android:id="@+id/channel_action_hint"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:visibility="gone" />
    <com.google.android.material.button.MaterialButton android:id="@+id/channel_open_connection"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:visibility="gone"
        android:text="@string/channels_open_facebook" />
    <LinearLayout android:id="@+id/channel_capabilities"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:orientation="vertical" />
  </LinearLayout>
</com.google.android.material.card.MaterialCardView>
