<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="vertical" android:padding="24dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/dashboard_title" android:textSize="28sp" android:textStyle="bold" />
    <TextView android:id="@+id/fixtureNotice" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="12dp"
        android:text="@string/dashboard_fixture" />
    <TextView android:id="@+id/networkStatus" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="12dp"
        android:text="@string/dashboard_offline" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" android:text="@string/dashboard_metric" />
    <Spinner android:id="@+id/metricSelector" android:layout_width="match_parent"
        android:layout_height="wrap_content" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" android:text="@string/dashboard_channel"
        android:textStyle="bold" />
    <TextView android:id="@+id/metricValue" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:textSize="32sp" android:textStyle="bold" />
    <TextView android:id="@+id/metricDetail" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="4dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" android:text="@string/dashboard_timeline"
        android:textStyle="bold" />
    <TextView android:id="@+id/timelineStart" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp" />
    <TextView android:id="@+id/timelineEnd" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp" />
    <TextView android:id="@+id/growthStatus" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="16dp" />
    <TextView android:id="@+id/topPostsStatus" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="16dp"
        android:text="@string/dashboard_no_posts" />
  </LinearLayout>
</ScrollView>
